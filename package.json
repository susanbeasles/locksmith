{
  "name": "locksmith",
  "version": "0.2.0",
  "description": "Zero Trust Credential Proxy — Token Substitution Engine",
  "private": true,
  "type": "module",
  "main": "dist/build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/build/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "deploy": "./deploy.sh apply",
    "deploy:plan": "./deploy.sh plan",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1009.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-iam": "^3.1009.0",
    "@aws-sdk/client-kms": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.1009.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "acme-client": "^5.4.0",
    "express": "^5.0.0",
    "jose": "^6.0.0",
    "uuid": "^11.0.0",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
